# ============================================================== Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# 虚拟环境（本项目实际用的是 %TEMP%\hd-build-venv，这里防手滑）
.venv/
.venv*/
venv/
env/
ENV/

# 静态检查 / 测试缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ====================================================== 打包与安装程序产物
# PyInstaller：build/ 是它的工作目录，dist/ 是默认输出（含手动 mv 进去的 dist/_old/）
# 试新布局时常用 --distpath dist_split 这类临时目录，这里一并挡掉
build*/
dist*/
*.manifest
*.spec.bak

# Inno Setup
# 注意：release/ 是有意保留的交付目录（安装包 + SHA256SUMS），不要忽略它
# release/ 下只跟踪各版本的 .exe 和 SHA256SUMS.txt；
# 在里面解压/试跑出来的子目录（如 release/作业备忘-绿色版-1.5.1/，几百个文件）一律不入库
release/*/
*.iss.bak

# 一次性脚本（发 Release、算哈希之类，跑完即删；留在这儿防止手滑提交）
_release_*.py
_upload_*.py

# ============================================================ 本地运行数据
# 运行期数据实际写在 %LOCALAPPDATA%\HomeworkDesk\data，这里只是兜底防误提交
data/
logs/
*.log
ball-state.json
credentials.dat
session.dat
oj_session.dat
prefs.json
themes.json
state.json
*.db
*.sqlite3
*.db-journal

# 调试 / 临时文件
_probe*.py
*.tmp
*.temp
*.bak
*.orig
*.rej
~$*
*.crdownload
*.part
# PrintWindow 抓帧核对主题/悬浮球用的截图
*.bmp

# ============================================================ 编辑器 / 系统
.vscode/
.idea/
*.swp
*.swo
*~
.history/
.DS_Store
.Spotlight-V100/
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
